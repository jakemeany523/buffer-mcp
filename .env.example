# Buffer MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# Get your access token: Buffer → Settings → API

# ── Required ────────────────────────────────────────────────────────────────
# Your Buffer API access token
BUFFER_ACCESS_TOKEN=your_access_token_here

# Your Buffer organization ID (run buffer_get_account to find it)
# NOTE: This is the org ID, NOT the account ID — they differ and using the
# wrong one causes silent "Organization not found" errors.
BUFFER_ORG_ID=your_org_id_here

# ── Optional: Channel shorthands ────────────────────────────────────────────
# Any BUFFER_CHANNEL_<PLATFORM> variable becomes a shorthand you can pass in
# place of a raw channel ID (e.g. BUFFER_CHANNEL_MASTODON enables "mastodon").
# Run buffer_list_channels to find your IDs. Recognized platforms include:
# twitter, linkedin, facebook, instagram, threads, mastodon, bluesky,
# pinterest, tiktok, youtube, google_business — but any name works.
BUFFER_CHANNEL_TWITTER=
BUFFER_CHANNEL_LINKEDIN=
BUFFER_CHANNEL_FACEBOOK=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_THREADS=
BUFFER_CHANNEL_MASTODON=
BUFFER_CHANNEL_BLUESKY=
BUFFER_CHANNEL_PINTEREST=
BUFFER_CHANNEL_TIKTOK=
BUFFER_CHANNEL_YOUTUBE=

# ── Optional: Twitter / X ───────────────────────────────────────────────────
# Your Twitter username (without @) for buffer_get_reply_links
BUFFER_TWITTER_USERNAME=

# Twitter API v2 bearer token — enables reply link lookups and engagement pulls
TWITTER_BEARER_TOKEN=

# ── Optional: Cloudflare R2 (for buffer_upload_image) ───────────────────────
# Buffer's media fetcher rejects many free CDNs. R2 is reliable and free-tier
# is generous. Create a bucket, enable public access, generate an API token
# with Object:Write, and fill in the values below.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_R2_BUCKET_NAME=buffer-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
